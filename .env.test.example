# Environment for the Playwright E2E tests. Copy to .env.test:
#   cp .env.test.example .env.test
#
# playwright.config.ts loads this file with override, so these values win over
# anything in your shell or .env. Tests refuse to run unless POSTGRES_URL points
# to localhost and the database name ends in "_test" — the test run WIPES it.
# Matches docker-compose.test.yml (start it with `npm run test:db:up`).
POSTGRES_URL="postgresql://surma:surma@localhost:5433/surma_test"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="e2e-not-a-real-secret"
BASE_URL="http://localhost:3000"

# Dummy values: email and Cloudinary calls are stubbed during tests
# (E2E_DISABLE_EMAIL / E2E_DISABLE_CLOUDINARY are set by playwright.config.ts).
SMTP_URL="localhost"
SMTP_PORT="2525"
SMTP_USERNAME="x"
SMTP_PASSWORD="x"
AWS_ACCESS_KEY_ID="x"
AWS_SECRET_ACCESS_KEY="x"
CLOUDINARY_URL="cloudinary://x:x@x"
# Inlined into the client bundle at build time; the player page crashes without it.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=e2e-test
NEXT_PUBLIC_CLOUDINARY_API_KEY=e2e-test
