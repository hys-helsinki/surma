generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model User {
  id            String      @id @default(uuid())
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  modifiedAt    DateTime    @default(now()) @db.Timestamptz(3)
  tournamentId  String?
  firstName     String
  lastName      String
  phone         String?
  email         String      @unique
  name          String?
  image         String?
  emailVerified DateTime?   @db.Timestamptz(3)
  teamId        String?
  role          UserRole    @default(USER)
  accounts      Account[]
  player        Player?
  sessions      Session[]
  umpire        Umpire?
  team          Team?       @relation(fields: [teamId], references: [id])
  tournament    Tournament? @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
}

model Player {
  id                  String       @id @default(uuid())
  createdAt           DateTime     @default(now()) @db.Timestamptz(3)
  modifiedAt          DateTime     @default(now()) @db.Timestamptz(3)
  lastVisit           DateTime?    @db.Timestamptz(3)
  userId              String       @unique
  tournamentId        String
  umpireId            String?
  alias               String
  address             String
  learningInstitution String?
  eyeColor            String?
  hair                String?
  height              String?
  other               String?
  calendar            Json?
  state               PlayerState  @default(ACTIVE)
  title               PlayerTitle?
  confirmed           Boolean      @default(false)
  safetyNotes         String?
  teamId              String?
  targets             Assignment[] @relation("PlayerHasTarget")
  hunters             Assignment[] @relation("PlayerIsHunted")
  team                Team?        @relation(fields: [teamId], references: [id])
  tournament          Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  umpire              Umpire?      @relation(fields: [umpireId], references: [id])
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Team {
  id           String           @id @default(uuid())
  createdAt    DateTime         @default(now())
  modifiedAt   DateTime         @default(now())
  name         String
  tournamentId String
  players      Player[]
  tournament   Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  targets      TeamAssignment[] @relation("TeamHasTarget")
  hunters      TeamAssignment[] @relation("TeamIsHunted")
  users        User[]
}

model Umpire {
  id             String     @id @default(uuid())
  createdAt      DateTime   @default(now())
  modifiedAt     DateTime   @default(now())
  userId         String     @unique
  tournamentId   String
  responsibility String?
  mainUmpire     Boolean    @default(false)
  players        Player[]
  tournament     Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Tournament {
  id                    String               @id @default(uuid())
  createdAt             DateTime             @default(now()) @db.Timestamptz(3)
  modifiedAt            DateTime             @default(now()) @db.Timestamptz(3)
  name                  String
  startTime             DateTime             @db.Timestamptz(3)
  endTime               DateTime             @db.Timestamptz(3)
  registrationStartTime DateTime             @db.Timestamptz(3)
  registrationEndTime   DateTime             @db.Timestamptz(3)
  teamGame              Boolean              @default(false)
  rings                 AssignmentRing[]
  players               Player[]
  teams                 Team[]
  teamAssignmentRings   TeamAssignmentRing[]
  umpires               Umpire[]
  users                 User[]
}

model Assignment {
  id                   String         @id @default(uuid())
  createdAt            DateTime       @default(now()) @db.Timestamptz(3)
  modifiedAt           DateTime       @default(now()) @db.Timestamptz(3)
  ringId               String
  hunterId             String
  targetId             String
  teamAssignmentRingId String?
  hunter               Player         @relation("PlayerHasTarget", fields: [hunterId], references: [id], onDelete: Cascade)
  ring                 AssignmentRing @relation(fields: [ringId], references: [id], onDelete: Cascade)
  target               Player         @relation("PlayerIsHunted", fields: [targetId], references: [id], onDelete: Cascade)
}

model AssignmentRing {
  id           String       @id @default(uuid())
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  modifiedAt   DateTime     @default(now()) @db.Timestamptz(3)
  name         String?
  tournamentId String
  assignments  Assignment[]
  tournament   Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
}

model TeamAssignment {
  id                   String              @id @default(uuid())
  createdAt            DateTime            @default(now()) @db.Timestamptz(3)
  modifiedAt           DateTime            @default(now()) @db.Timestamptz(3)
  teamAssignmentRingId String?
  huntingTeamId        String
  targetTeamId         String
  huntingTeam          Team                @relation("TeamHasTarget", fields: [huntingTeamId], references: [id], onDelete: Cascade)
  targetTeam           Team                @relation("TeamIsHunted", fields: [targetTeamId], references: [id], onDelete: Cascade)
  teamAssignmentRing   TeamAssignmentRing? @relation(fields: [teamAssignmentRingId], references: [id], onDelete: Cascade)
}

model TeamAssignmentRing {
  id           String           @id @default(uuid())
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  modifiedAt   DateTime         @default(now()) @db.Timestamptz(3)
  name         String?
  tournamentId String
  assignments  TeamAssignment[]
  tournament   Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum PlayerState {
  ACTIVE
  DEAD
  DETECTIVE
  EXTRA
}

enum PlayerTitle {
  KK
  MM
  LL
  TT
}

enum UserRole {
  ADMIN
  USER
}
